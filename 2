Practical 2
Question: Perform the following in customer_data.csv
•	Drop exact duplicate rows (e.g. C021 appears twice)
•	'Customer_Lifespan_Months' has an invalid placeholder "XXXX" -> convert to NaN
•	Parse date column properly
•	Fill missing values
•	Label Encoding
•	Outliers making use of box plot

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder
 
df = pd.read_csv("customer_data.csv")
print(df.shape)
print(df.columns.tolist())
df.info()
 
# Task 1: Drop exact duplicate rows (e.g. C021 appears twice)
print("Duplicate rows:", df.duplicated().sum())
df = df.drop_duplicates()
 
# Task 2: Invalid placeholder "XXXX" -> NaN
df = df.replace("XXXX", np.nan)
df["Customer_Lifespan_Months"] = pd.to_numeric(
    df["Customer_Lifespan_Months"], errors="coerce")
 
# Task 3: Parse date column properly (any column with 'date' in its name)
date_cols = [c for c in df.columns if "date" in c.lower()]
for c in date_cols:
    df[c] = pd.to_datetime(df[c], errors="coerce")
df.info()
 
# Task 4: Fill missing values (check first, then fill)
print(df.isnull().sum())
sns.heatmap(df.isnull(), cbar=False, cmap="viridis")
plt.title("Missing Values")
plt.show()
 
num_cols = df.select_dtypes(include="number").columns
cat_cols = df.select_dtypes(exclude=["number", "datetime"]).columns
 
df[num_cols] = df[num_cols].fillna(df[num_cols].median())   # numeric -> median
for c in cat_cols:                                          # text -> mode
    if df[c].isnull().any():
        df[c] = df[c].fillna(df[c].mode()[0])
for c in date_cols:                                         # dates -> median date
    df[c] = df[c].fillna(df[c].median())
print("Missing after filling:", df.isnull().sum().sum())
 
# Task 5: Label Encoding (text columns with few categories, e.g. Gender)
for c in cat_cols:
    if df[c].nunique() < 10:
        df[c + "_encoded"] = LabelEncoder().fit_transform(df[c])
print(df.head())
 
# Task 6: Outliers using box plots
fig, axes = plt.subplots(1, len(num_cols), figsize=(4 * len(num_cols), 4))
axes = np.atleast_1d(axes)
for ax, c in zip(axes, num_cols):
    sns.boxplot(y=df[c], ax=ax)
    ax.set_title(c)
plt.tight_layout()
plt.show()
Note: If Customer_Lifespan_Months or the date column has a different name, change only that name. If most dates become NaT, add dayfirst=True to pd.to_datetime.
Practical 3
Question: Perform simple and stratified sampling on penguin dataset

import pandas as pd
 
df = pd.read_csv("penguins_size.csv")
df = df.dropna(subset=["body_mass_g", "species"])      # avoid NaN results
 
TRUE_MEAN = df["body_mass_g"].mean()
N = 100
print(f"Population mean body mass: {TRUE_MEAN:.1f} g")
 
# Task 1: Simple random sampling
srs = df.sample(n=N, random_state=1)
srs_mean = srs["body_mass_g"].mean()
print(f"SRS mean: {srs_mean:.1f} g | error: {abs(srs_mean - TRUE_MEAN):.1f} g")
 
# Task 2: Stratified sampling (proportional, by species)
parts = []
for species, group in df.groupby("species"):
    n_s = max(1, round(N * len(group) / len(df)))
    parts.append(group.sample(n=n_s, random_state=1))
strat = pd.concat(parts)
strat_mean = strat["body_mass_g"].mean()
print(f"Stratified size: {len(strat)}")
print(f"Stratified mean: {strat_mean:.1f} g | error: {abs(strat_mean - TRUE_MEAN):.1f} g")
 
# Proportions: population vs stratified sample
print(pd.DataFrame({
    "population_%": df["species"].value_counts(normalize=True).round(3),
    "sample_%": strat["species"].value_counts(normalize=True).round(3)}))
Note: Stratified total can be 101 because each species count is rounded. Mention this if asked; train_test_split(df, test_size=100, stratify=df['species']) gives exactly 100.
Practical 4
Question: CLT on exponential data

import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
 
np.random.seed(42)
num_samples = 10000      # number of repetitions
sample_size = 30         # size of each sample
 
# Non-normal population: Exponential (scale = 2 -> mean 2, std 2)
population = np.random.exponential(scale=2.0, size=num_samples * sample_size)
 
# Mean of each random sample
sample_means = [np.mean(np.random.choice(population, size=sample_size))
                for _ in range(num_samples)]
 
print("Population mean:", round(population.mean(), 3))
print("Mean of sample means:", round(np.mean(sample_means), 3))
print("Std of sample means:", round(np.std(sample_means), 3),
      "(theory: 2/sqrt(30) = 0.365)")
 
plt.figure(figsize=(14, 6))
plt.subplot(1, 2, 1)
sns.histplot(population, bins=50, kde=True, color="skyblue")
plt.title("Original Exponential Distribution")
 
plt.subplot(1, 2, 2)
sns.histplot(sample_means, bins=50, kde=True, color="salmon")
plt.title(f"Distribution of Sample Means (n={sample_size})")
plt.show()
Note: Expected: mean of sample means about 2.0, standard deviation about 0.365 (2 / sqrt(30)).
Practical 5
Question: Perform Bootstrap resampling on Iris dataset

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
 
df = pd.read_csv("iris.csv")
print(df.columns.tolist())
 
# finds the petal-length column whatever its exact spelling
col = [c for c in df.columns if "petal" in c.lower() and "length" in c.lower()][0]
data = df[col].dropna().to_numpy()
 
np.random.seed(42)
n_boot = 5000
boot_means = [np.mean(np.random.choice(data, size=len(data), replace=True))
              for _ in range(n_boot)]
 
ci_lower, ci_upper = np.percentile(boot_means, [2.5, 97.5])
obs_mean = data.mean()
print(f"Observed mean: {obs_mean:.2f}")
print(f"95% CI: ({ci_lower:.2f}, {ci_upper:.2f})")
 
plt.figure(figsize=(8, 5))
plt.hist(boot_means, bins=40, color="skyblue", edgecolor="black")
plt.axvline(ci_lower, color="red", linestyle="--", label=f"Lower CI = {ci_lower:.2f}")
plt.axvline(ci_upper, color="red", linestyle="--", label=f"Upper CI = {ci_upper:.2f}")
plt.axvline(obs_mean, color="green", label="Observed Mean")
plt.title("Bootstrap Distribution of Mean Petal Length")
plt.xlabel("Mean Petal Length")
plt.ylabel("Frequency")
plt.legend()
plt.show()
Note: The column finder works for petal_length, PetalLengthCm and 'petal length (cm)'.
Practical 6
Question: Calculate MLE on Iris dataset

import pandas as pd
import numpy as np
 
df = pd.read_csv("iris.csv")
col = [c for c in df.columns if "petal" in c.lower() and "length" in c.lower()][0]
data = df[col].dropna().to_numpy()          # REAL Iris data, not synthetic
 
# MLE for a Normal(mu, sigma^2) model
mu_mle = np.mean(data)                          # (1/n) * sum(x)
sigma2_mle = np.mean((data - mu_mle) ** 2)      # (1/n) * sum((x-mu)^2)  <- divides by n
 
print(f"MLE Mean (mu): {mu_mle:.4f}")
print(f"MLE Variance (sigma^2): {sigma2_mle:.4f}")
Note: MLE variance divides by n, not n-1.
Practical 7
Question: Plot the clusters in the dataset on Social_Network_Ads.csv

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
 
df = pd.read_csv("Social_Network_Ads.csv")
X = df[["Age", "EstimatedSalary"]]
 
# Scale so Age and Salary count equally
X_scaled = StandardScaler().fit_transform(X)
 
# Fit K-Means once
k = 3
df["Cluster"] = KMeans(n_clusters=k, n_init=10, random_state=42).fit_predict(X_scaled)
 
# Plot the clusters
plt.scatter(df["Age"], df["EstimatedSalary"], c=df["Cluster"], cmap="viridis")
plt.xlabel("Age")
plt.ylabel("Estimated Salary")
plt.title("K-Means Clusters")
plt.show()
 
# Profile of each cluster
print(df.groupby("Cluster")[["Age", "EstimatedSalary", "Purchased"]].mean().round(2))
Note: k = 3 is a chosen value, not proven optimal. Scaling is why Age is not ignored.
 
